# =============================================================================
# LexiGuard Enterprise Security Gateway - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to a new file named `.env`:
#      Linux/macOS : cp .env.example .env
#      Windows     : copy .env.example .env
# 2. Fill in your API keys below (all keys are optional; LexiGuard will run
#    its comprehensive offline static heuristics even if all keys are blank).
# =============================================================================

# -----------------------------------------------------------------------------
# Cloud Threat Intelligence (Optional)
# -----------------------------------------------------------------------------
# VirusTotal v3 API Key for file hash & URL consensus lookups
# Get a free key at: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_virustotal_api_key_here

# Google Web Risk API Key for cloud blacklisting verification
# Get a key at: https://console.cloud.google.com/apis/credentials
GOOGLE_WEBRISK_API_KEY=your_google_webrisk_api_key_here

# Hybrid Analysis / Falcon Sandbox API Key (Optional)
# Get a key at: https://www.hybrid-analysis.com/
HYBRID_ANALYSIS_API_KEY=your_hybrid_analysis_api_key_here

# Abuse.ch / URLhaus API Key (Optional)
# Get a key at: https://urlhaus.abuse.ch/api/
ABUSE_CH_AUTH_KEY=your_abuse_ch_api_key_here

# -----------------------------------------------------------------------------
# Incident Response & Webhook Alert Endpoints (Optional)
# -----------------------------------------------------------------------------
# Slack Incoming Webhook URL for SOC alerts
LEXIGUARD_SLACK_WEBHOOK=

# Discord Webhook URL for real-time security alerts
LEXIGUARD_DISCORD_WEBHOOK=

# Microsoft Teams Connector Webhook URL
LEXIGUARD_TEAMS_WEBHOOK=

# Enterprise SIEM / SOAR Ingestion Endpoint (Splunk HEC, Elastic SIEM, etc.)
LEXIGUARD_SIEM_WEBHOOK=

# -----------------------------------------------------------------------------
# Persistence & Database Configuration
# -----------------------------------------------------------------------------
# Custom SQLite database location override (defaults to ./lexiguard.db in repo root)
LEXIGUARD_DB_PATH=
